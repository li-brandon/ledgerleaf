# Copy to .env (gitignored) and fill in your Plaid keys from https://dashboard.plaid.com/developers/keys
# Only `npm run plaid-server` reads these; the browser never sees them.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox is the default. Anything else is refused unless PLAID_ALLOW_NON_SANDBOX=true.
PLAID_ENV=sandbox
# Port for the local server (bound to 127.0.0.1 only). The Vite dev server proxies /api/plaid here.
PLAID_SERVER_PORT=8787
# Where access tokens and sync cursors are stored (gitignored).
PLAID_DATA_DIR=.plaid-data
